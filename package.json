{
  "name": "web-sdk-pp-tinypose",
  "version": "0.1.0-alpha.0",
  "description": "基于 PP-TinyPose 的浏览器人体关键点 SDK（本地验证版）",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/chenmohan123/web-sdk-PP-TinyPose.git" },
  "homepage": "https://chenmohan123.github.io/web-sdk-PP-TinyPose/",
  "files": ["dist", "README.md", "README.en.md", "LICENSE", "NOTICE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./inference.worker.js": "./dist/inference.worker.js" },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts --host 127.0.0.1",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": { "onnxruntime-web": "1.27.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "playwright": "1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
